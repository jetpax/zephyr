if SOC_BCM2710

config NUM_IRQS
	# TODO: revisit once the BCM2835/2836 interrupt controller driver lands;
	# placeholder copied from BCM2711 (which counts GIC SPIs).
	default 260

config SYS_CLOCK_HW_CYCLES_PER_SEC
	# BCM2710 ARM generic timer runs at 19.2 MHz, set by the VPU
	# firmware before kernel handoff. (BCM2711 uses 54 MHz.)
	default 19200000

config DCACHE_LINE_SIZE
	# Cortex-A53 L1 D-cache line size is 64 bytes (ARMv8-A standard).
	# Required by the USB device stack (include/zephyr/drivers/usb/usb_buf.h
	# uses CONFIG_DCACHE_LINE_SIZE for DMA-safe buffer alignment); also
	# correct for any future cache-management work on this SoC.
	default 64

endif
