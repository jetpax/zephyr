if SOC_BCM2710

config NUM_IRQS
	# TODO: revisit once the BCM2835/2836 interrupt controller driver lands;
	# placeholder copied from BCM2711 (which counts GIC SPIs).
	default 260

config SYS_CLOCK_HW_CYCLES_PER_SEC
	# BCM2710 ARM generic timer runs at 19.2 MHz, set by the VPU
	# firmware before kernel handoff. (BCM2711 uses 54 MHz.)
	default 19200000

endif
