#include <broadcom/bcm283x-pinctrl.dtsi>

&pinctrl {
	uart2_gpio0: uart2-gpio0 {
		group1 {
			pinmux = <UART2_TX_GPIO0>,
				 <UART2_RX_GPIO1>;
		};
	};

	uart2_ctsrts_gpio0: uart2-ctsrts-gpio0 {
		group1 {
			pinmux = <UART2_TX_GPIO0>,
				 <UART2_RX_GPIO1>,
				 <UART2_CTS_GPIO2>,
				 <UART2_RTS_GPIO3>;
		};
	};

	uart3_gpio4: uart3-gpio4 {
		group1 {
			pinmux = <UART3_TX_GPIO4>,
				 <UART3_RX_GPIO5>;
		};
	};

	uart3_ctsrts_gpio4: uart3-ctsrts-gpio4 {
		group1 {
			pinmux = <UART3_TX_GPIO4>,
				 <UART3_RX_GPIO5>,
				 <UART3_CTS_GPIO6>,
				 <UART3_RTS_GPIO7>;
		};
	};

	uart4_gpio8: uart4-gpio8 {
		group1 {
			pinmux = <UART4_TX_GPIO8>,
				 <UART4_RX_GPIO9>;
		};
	};

	uart4_ctsrts_gpio8: uart4-ctsrts-gpio8 {
		group1 {
			pinmux = <UART4_TX_GPIO8>,
				 <UART4_RX_GPIO9>,
				 <UART4_CTS_GPIO10>,
				 <UART4_RTS_GPIO11>;
		};
	};

	uart5_gpio12: uart5-gpio12 {
		group1 {
			pinmux = <UART5_TX_GPIO12>,
				 <UART5_RX_GPIO13>;
		};
	};

	uart5_ctsrts_gpio12: uart5-ctsrts-gpio12 {
		group1 {
			pinmux = <UART5_TX_GPIO12>,
				 <UART5_RX_GPIO13>,
				 <UART5_CTS_GPIO14>,
				 <UART5_RTS_GPIO15>;
		};
	};

	/* Arasan SDHCI on GPIO 34..39 (ALT3) plus GPCLK2 on GPIO 43
	 * (ALT0 -- the wireless-module reference clock). Linux's
	 * bcm283x.dtsi separates these into emmc_gpio34 and
	 * gpclk2_gpio43, but Zephyr's Z_PINCTRL_STATE_PINS_INIT only
	 * walks the first phandle in pinctrl-0, so we collect both pin
	 * groups under one phandle here. Used on Pi 3 / Pi Zero 2 W
	 * for the on-module CYW43439 wireless chip.
	 *
	 * Bias is per-group: CLK and GPCLK2 take no pull (they're
	 * actively driven outputs); CMD and DAT0..3 want pull-up so
	 * they idle high between transactions, as the SDIO spec and
	 * the CYW43439 datasheet require. Linux's emmc_gpio34 group
	 * does the same (BCM2835_PUD_OFF on CLK, _UP on the rest).
	 */
	emmc_gpio34: emmc-gpio34 {
		group_clk {
			pinmux = <EMMC_CLK_GPIO34>,
				 <GPCLK2_GPIO43>;
			/* Explicit bias-disable on the clock pins.
			 * Pi-downstream Linux's bcm283x.dtsi puts these at
			 * BCM2835_PUD_OFF and the CYW43xxx chip's SDIO clock
			 * input prefers an actively-driven line with no pull.
			 */
			bias-disable;
		};
		group_data {
			pinmux = <EMMC_CMD_GPIO35>,
				 <EMMC_DAT0_GPIO36>,
				 <EMMC_DAT1_GPIO37>,
				 <EMMC_DAT2_GPIO38>,
				 <EMMC_DAT3_GPIO39>;
			bias-pull-up;
		};
	};

	/* BSC1 ("I2C1") on GPIO 2 (SDA) and GPIO 3 (SCL) at ALT0 -- the
	 * user-facing I2C bus on the Raspberry Pi 40-pin header. The Pi
	 * board has fixed 1.8 kOhm external pull-ups on these lines, so
	 * the internal pull-up is strictly belt-and-braces, matching what
	 * Linux's i2c1_gpio2 group does (bias-pull-up on both pins).
	 */
	i2c1_gpio2: i2c1-gpio2 {
		group1 {
			pinmux = <I2C1_SDA_GPIO2>,
				 <I2C1_SCL_GPIO3>;
			bias-pull-up;
		};
	};

	/* Legacy SDHost on GPIO 48..53 (ALT0) -- SDCLK / SDCMD / SDDAT0..3
	 * for the external microSD card slot on Pi 3 / Pi Zero 2 W. The
	 * Arasan SDHCI controller on the same SoC uses GPIO 34..39 / ALT3
	 * for the on-module CYW43439 wireless chip (emmc_gpio34 above);
	 * both controllers coexist.
	 *
	 * Bias matches the SDIO pin idle requirements (and Linux's
	 * sdhost_gpio48 group): CLK actively driven with no pull, CMD and
	 * DAT0..3 pulled up so they idle high between transactions.
	 */
	sdhost_gpio48: sdhost-gpio48 {
		group_clk {
			pinmux = <SDHOST_CLK_GPIO48>;
			bias-disable;
		};
		group_data {
			pinmux = <SDHOST_CMD_GPIO49>,
				 <SDHOST_DAT0_GPIO50>,
				 <SDHOST_DAT1_GPIO51>,
				 <SDHOST_DAT2_GPIO52>,
				 <SDHOST_DAT3_GPIO53>;
			bias-pull-up;
		};
	};
};
