 * SPDX-License-Identifier: Apache-2.0
 *
 * BCM2710 (Pi 3 / Pi Zero 2 W) device tree.
 *
 * Phase 1b.0: GIC node replaced by the proper BCM283x intc pair --
 *   - brcm,bcm2836-l1-intc at 0x40000000 (per-core timers, mailboxes,
 *     PMU, and the GPU cascade);
 *   - brcm,bcm2835-armctrl-ic at 0x3f00b200 (peripheral aggregator
 *     hanging off the GPU IRQ of the L1 controller).
 *
 * The arch layer uses CONFIG_ARM_CUSTOM_INTERRUPT_CONTROLLER and the
 * z_soc_irq_* hooks in soc/brcm/bcm2710/soc_irq.c. Those hooks are
 * stubs in this commit -- the actual ISR dispatch lands in 1b.1, so
 * IRQ delivery is silently disabled at runtime for now. The build
 * is structurally correct.
 */

#include <mem.h>
#include <freq.h>

#include <arm64/armv8-a.dtsi>
#include <zephyr/dt-bindings/interrupt-controller/bcm2836-l1.h>
#include <zephyr/dt-bindings/interrupt-controller/bcm2835-armctrl.h>

/ {
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0>;
		};
	};

	interrupt-parent = <&armctrl_intc>;

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&local_intc>;
		/*
		 * Index order is canonical (matches the arm,armv8-timer
		 * binding):
		 *   0 = secure phys, 1 = nonsec phys, 2 = virtual,
		 *   3 = hypervisor phys.
		 */
		interrupts = <BCM2836_LOCAL_IRQ_CNTPSIRQ  IRQ_TYPE_LEVEL 0>,
			     <BCM2836_LOCAL_IRQ_CNTPNSIRQ IRQ_TYPE_LEVEL 0>,
			     <BCM2836_LOCAL_IRQ_CNTVIRQ   IRQ_TYPE_LEVEL 0>,
			     <BCM2836_LOCAL_IRQ_CNTHPIRQ  IRQ_TYPE_LEVEL 0>;
	};

	clocks {
		clk_uart: clk-uart {
			compatible = "fixed-clock";
			clock-frequency = <DT_FREQ_M(48)>;
			#clock-cells = <0>;
		};
	};

	soc {
		/*
		 * DRAM region the Zephyr image is linked into. Base
		 * 0x200000 (2 MiB) leaves the bottom 2 MiB free; the
		 * Pi firmware's default kernel8.img load address is
		 * 0x80000, so a `kernel_address=0x200000` line in
		 * config.txt is required when flashing to real hardware.
		 *
		 * Size 0x10000000 = 256 MiB. Pi Zero 2 W has 512 MiB of
		 * DRAM total; the VPU firmware reserves ~64 MiB at the
		 * top (0x1c000000..0x20000000), so 0x80000..0x1c000000
		 * is the usable ARM-side window. We claim 256 MiB
		 * starting at 0x200000, which is well within bounds and
		 * leaves room for VPU communication buffers etc. that
		 * would normally live just above the kernel.
		 */
		sram0: memory@200000 {
			device_type = "memory";
			compatible = "mmio-sram";
			reg = <0x200000 0x10000000>;
		};

		local_intc: interrupt-controller@40000000 {
			compatible = "brcm,bcm2836-l1-intc";
			reg = <0x40000000 0x100>;
			interrupt-controller;
			#interrupt-cells = <3>;
			status = "okay";
		};

		armctrl_intc: interrupt-controller@3f00b200 {
			compatible = "brcm,bcm2835-armctrl-ic";
			reg = <0x3f00b200 0x200>;
			interrupt-parent = <&local_intc>;
			interrupts = <BCM2836_LOCAL_IRQ_GPU IRQ_TYPE_LEVEL 0>;
			interrupt-controller;
			#interrupt-cells = <3>;
			status = "okay";
		};

		/*
		 * ARM <-> VideoCore mailbox. Single hardware FIFO pair
		 * shared by 16 channels; the property-tag protocol (firmware
		 * node below) sits on channel 8. Bus 0x7e00b880 → ARM
		 * 0x3f00b880; 0x40-byte register window covers MAIL0/MAIL1
		 * read/status/config/write.
		 *
		 * Shares the 64 KB MMU page at 0x3f00b000 with the ARMC IRQ
		 * controller above; both use K_MEM_CACHE_NONE so the
		 * arch_mem_map attr-match constraint is satisfied (see
		 * feedback memory feedback_zephyr_mmio_attrs_match_for_64kb_
		 * page_cotenants).
		 *
		 * Default disabled; board / sample overlay opts in.
		 */
		mailbox: mailbox@3f00b880 {
			compatible = "brcm,bcm2835-mbox";
			reg = <0x3f00b880 0x40>;
			#mbox-cells = <0>;
			status = "disabled";
		};

		/*
		 * VideoCore firmware property-tag interface. Virtual node
		 * with no MMIO of its own -- the driver builds property
		 * request buffers and sends them via &mailbox channel 8.
		 *
		 * Used during peripheral bring-up to flip on SoC power
		 * islands the VC start.elf leaves off (USB analog PHY,
		 * SDHCI on some configs, etc.).
		 */
		firmware: firmware {
			compatible = "brcm,bcm2835-firmware";
			mboxes = <&mailbox>;
			status = "disabled";

			/*
			 * SoC temperature sensor, read via the firmware
			 * GET_TEMPERATURE property tag (vcgencmd measure_temp
			 * source). Board / sample overlay opts in.
			 */
			vc_thermal: vc-thermal {
				compatible = "raspberrypi,bcm2835-vc-thermal";
				status = "disabled";
			};

			/*
			 * VideoCore firmware framebuffer (HDMI). VC owns the
			 * HDMI block, brings up the PHY from config.txt at
			 * boot, and continuously scans this buffer out to the
			 * cable. ARM side asks for the buffer at runtime via
			 * the FB property tags (ALLOCATE_BUFFER + friends).
			 *
			 * No width / height set here: the binding defaults
			 * both to 0, which the driver interprets as "ask VC
			 * for whatever the monitor's EDID negotiated". An
			 * overlay can override with explicit pixels.
			 *
			 * Board / sample overlay opts in.
			 */
			vc_fb: vc-fb {
				compatible = "brcm,bcm2835-fb";
				status = "disabled";
			};
		};

		rng: rng@3f104000 {
			/*
			 * BCM2710 / BCM2837 / BCM2835 (Pi 1/2/3/Zero family)
			 * carries the simple bcm2835-rng — NOT the iProc RNG200
			 * (which is BCM2711 / Pi 4 only). Register block is 16
			 * bytes (CTRL/STATUS/DATA/INT_MASK), not 0x28.
			 */
			compatible = "brcm,bcm2835-rng";
			reg = <0x3f104000 0x10>;
			status = "okay";
		};

		pinctrl: pin-controller@3f200000 {
			compatible = "brcm,bcm2711-pinctrl";
			reg = <0x3f200000 0xf4>;
			#address-cells = <1>;
			#size-cells = <0>;
			/* BCM2710 uses the GPPUD/GPPUDCLK pull sequence;
			 * the modern PUP_PDN_CNTRL_REG at 0xE4 is reserved
			 * on this silicon. See driver for details.
			 */
			legacy-pull-control;

			/* GPIO 0 ~ 27. legacy-pull-control selects the
			 * BCM2835-family GPPUD/GPPUDCLK pull sequence; the
			 * default BCM2711 PUP_PDN_CNTRL_REG at 0xE4 is
			 * reserved on this silicon.
			 */
			gpio0: gpio@0 {
				compatible = "brcm,bcm2711-gpio";
				reg = <0>;
				interrupts = <BCM2835_IRQ_GPIO0 IRQ_TYPE_LEVEL 0>;
				gpio-controller;
				#gpio-cells = <2>;
				ngpios = <28>;
				legacy-pull-control;
				status = "okay";
			};

			/* GPIO 28 ~ 45 */
			gpio1: gpio@1c {
				compatible = "brcm,bcm2711-gpio";
				reg = <28>;
				interrupts = <BCM2835_IRQ_GPIO1 IRQ_TYPE_LEVEL 0>;
				gpio-controller;
				#gpio-cells = <2>;
				ngpios = <18>;
				legacy-pull-control;
				status = "okay";
			};
		};

		uart0: uart@3f201000 {
			compatible = "arm,pl011";
			reg = <0x3f201000 0x200>;
			interrupts = <BCM2835_IRQ_UART IRQ_TYPE_LEVEL 0>;
			interrupt-names = "uart0";
			clocks = <&clk_uart>;
			status = "disabled";
		};

		uart1: uart@3f215040 {
			compatible = "brcm,bcm2711-aux-uart";
			reg = <0x3f215040 0x40>;
			clock-frequency = <DT_FREQ_M(250)>;
			interrupts = <BCM2835_IRQ_AUX IRQ_TYPE_LEVEL 0>;
			status = "disabled";
		};

		uart2: uart@3f201400 {
			compatible = "arm,pl011";
			reg = <0x3f201400 0x200>;
			interrupts = <BCM2835_IRQ_UART IRQ_TYPE_LEVEL 0>;
			interrupt-names = "uart2";
			clocks = <&clk_uart>;
			status = "disabled";
		};

		uart3: uart@3f201600 {
			compatible = "arm,pl011";
			reg = <0x3f201600 0x200>;
			interrupts = <BCM2835_IRQ_UART IRQ_TYPE_LEVEL 0>;
			interrupt-names = "uart3";
			clocks = <&clk_uart>;
			status = "disabled";
		};

		uart4: uart@3f201800 {
			compatible = "arm,pl011";
			reg = <0x3f201800 0x200>;
			interrupts = <BCM2835_IRQ_UART IRQ_TYPE_LEVEL 0>;
			interrupt-names = "uart4";
			clocks = <&clk_uart>;
			status = "disabled";
		};

		uart5: uart@3f201a00 {
			compatible = "arm,pl011";
			reg = <0x3f201a00 0x200>;
			interrupts = <BCM2835_IRQ_UART IRQ_TYPE_LEVEL 0>;
			interrupt-names = "uart5";
			clocks = <&clk_uart>;
			status = "disabled";
		};

		/*
		 * DMA controller -- a control-block (linked-list
		 * descriptor) engine. The I2S and SPI peripherals pace
		 * transfers off it via DREQ. Default disabled; board /
		 * test overlays opt in.
		 *
		 * brcm,dma-channel-mask = 0x7f30 keeps channels 4,5,8..14
		 * and excludes the VideoCore-firmware-reserved and
		 * special-function channels (0,1,2,3,6,7). The interrupts
		 * list covers exactly those mask channels: 4,5,8,9,10 have
		 * dedicated lines, 11..14 share one.
		 */
		dma: dma@3f007000 {
			compatible = "brcm,bcm2835-dma";
			reg = <0x3f007000 0xf00>;
			interrupts = <BCM2835_IRQ_DMA(4)  IRQ_TYPE_LEVEL 0>,
				     <BCM2835_IRQ_DMA(5)  IRQ_TYPE_LEVEL 0>,
				     <BCM2835_IRQ_DMA(8)  IRQ_TYPE_LEVEL 0>,
				     <BCM2835_IRQ_DMA(9)  IRQ_TYPE_LEVEL 0>,
				     <BCM2835_IRQ_DMA(10) IRQ_TYPE_LEVEL 0>,
				     <BCM2835_IRQ_DMA_SHARED IRQ_TYPE_LEVEL 0>;
			#dma-cells = <1>;
			dma-channels = <16>;
			brcm,dma-channel-mask = <0x7f30>;
			dma-buf-addr-alignment = <64>;
			status = "disabled";
		};

		/*
		 * PCM / I2S audio interface on the 40-pin header (GPIO
		 * 18..21, ALT0). DMA-paced: sample buffers stream through
		 * the BCM2835 DMA controller, PCM TX = DREQ 2, RX = DREQ 3.
		 * Default disabled; a board or test overlay opts in -- and
		 * must also enable &dma, which the dmas phandles reference.
		 *
		 * In master mode the bit clock comes from the SoC clock
		 * manager's PCM clock; the driver programs that divider
		 * directly, so there is no clocks phandle here. The
		 * interrupts entry is the PCM peripheral's own TXW/RXR/
		 * error line -- declared as a hardware fact; the current
		 * polled-DMA driver does not connect it.
		 */
		i2s: i2s@3f203000 {
			compatible = "brcm,bcm2835-i2s";
			reg = <0x3f203000 0x24>;
			interrupts = <BCM2835_IRQ_PCM IRQ_TYPE_LEVEL 0>;
			dmas = <&dma 2>, <&dma 3>;
			dma-names = "tx", "rx";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		/*
		 * SPI0 -- the "main" SPI controller on the 40-pin header
		 * (GPIO 7..11, ALT0). Default disabled; board overlays
		 * opt in and add cs-gpios plus a pinctrl group.
		 *
		 * clock-frequency tracks the VPU core clock, which is
		 * 250 MHz when config.txt sets core_freq=250 -- the same
		 * knob the mini-UART baud divisor already depends on.
		 */
		spi0: spi@3f204000 {
			compatible = "brcm,bcm2835-spi";
			reg = <0x3f204000 0x200>;
			interrupts = <BCM2835_IRQ_SPI IRQ_TYPE_LEVEL 0>;
			clock-frequency = <DT_FREQ_M(250)>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		/*
		 * BSC ("Broadcom Serial Controller") I2C masters. Three
		 * instances on this silicon family: BSC0 lives on the main
		 * peripheral page, BSC1 / BSC2 sit on the secondary page at
		 * 0x3f80x000. Conventionally BSC0 is the HAT-ID-EEPROM bus
		 * (GPIO 0/1, used by the firmware at boot), BSC1 is the
		 * user-facing 40-pin-header bus on GPIO 2/3, and BSC2 is
		 * reserved for HDMI's DDC line and shouldn't be enabled by
		 * application code.
		 *
		 * All three share interrupt line BCM2835_IRQ_I2C -- Linux's
		 * driver declares the same on each node and uses IRQF_SHARED
		 * at request time. With status="disabled" by default only
		 * one will normally be enabled at runtime, so the sharing
		 * doesn't matter in practice; if a board enables more than
		 * one, the build will fail at IRQ_CONNECT-duplicate time,
		 * which is the right place to surface the conflict.
		 *
		 * Default disabled; board / sample overlay opts in.
		 *
		 * core-clock-frequency tracks the VPU core clock that feeds
		 * the BSC CDIV divider, typ. 250 MHz with core_freq=250 in
		 * config.txt (the same knob SPI0 and SDHost already depend
		 * on). The bus rate is set per-node via the standard
		 * clock-frequency property; the board overlay supplies it.
		 */
		i2c0: i2c@3f205000 {
			compatible = "brcm,bcm2835-i2c";
			reg = <0x3f205000 0x200>;
			interrupts = <BCM2835_IRQ_I2C IRQ_TYPE_LEVEL 0>;
			core-clock-frequency = <DT_FREQ_M(250)>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c1: i2c@3f804000 {
			compatible = "brcm,bcm2835-i2c";
			reg = <0x3f804000 0x200>;
			interrupts = <BCM2835_IRQ_I2C IRQ_TYPE_LEVEL 0>;
			core-clock-frequency = <DT_FREQ_M(250)>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c2: i2c@3f805000 {
			compatible = "brcm,bcm2835-i2c";
			reg = <0x3f805000 0x200>;
			interrupts = <BCM2835_IRQ_I2C IRQ_TYPE_LEVEL 0>;
			core-clock-frequency = <DT_FREQ_M(250)>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		/*
		 * Legacy SDHost controller. On Pi 3 / Pi Zero 2 W this is
		 * the controller wired to the external microSD card slot
		 * via GPIO 48..53 at ALT0. Proprietary Broadcom register
		 * layout, distinct from the Arasan SDHCI block at
		 * 0x3f300000 below. Default disabled -- board overlays opt
		 * in.
		 *
		 * clock-frequency tracks the VPU core clock that feeds
		 * SDHost's SDCDIV reference divider, typ. 250 MHz with
		 * core_freq=250 in config.txt.
		 */
		sdhost: mmc@3f202000 {
			compatible = "brcm,bcm2835-sdhost";
			reg = <0x3f202000 0x100>;
			interrupts = <BCM2835_IRQ_SDHOST IRQ_TYPE_LEVEL 0>;
			clock-frequency = <DT_FREQ_M(250)>;
			bus-width = <4>;
			status = "disabled";
		};

		/*
		 * Arasan SDHCI controller (EMMC). On Pi Zero 2 W this is
		 * wired to the CYW43439 wireless module. Default disabled --
		 * board overlays opt in. The clock-frequency property
		 * tracks clk_emmc set by the VPU firmware; see the board
		 * doc for the config.txt knob (typ. 100 MHz with
		 * core_freq=250).
		 */
		emmc: sdhci@3f300000 {
			compatible = "brcm,bcm2835-sdhci";
			reg = <0x3f300000 0x100>;
			interrupts = <BCM2835_IRQ_ARASAN_SDIO IRQ_TYPE_LEVEL 0>;
			/* Actual clk_emmc rate set by VPU firmware: PLLC_CORE0
			 * (1 GHz) / DIVI 5 = 200 MHz. Confirmed via Linux's
			 * /sys/kernel/debug/clk/clk_summary on the same board.
			 * Earlier this was 100 MHz, which was just wrong --
			 * it made our calc_clk_div produce divider 125 for a
			 * 400 kHz target, yielding actual 800 kHz SDCLK and
			 * exceeding the SD spec's 400 kHz card-identification
			 * limit. CYW43439 wouldn't ack any commands.
			 */
			clock-frequency = <DT_FREQ_M(200)>;
			bus-width = <4>;
			/* DREQ 11 = Arasan SDHCI BUFFER FIFO (per BCM2835 ARM
			 * Peripherals datasheet ch. 4 DMA controller, and
			 * Linux's bcm270x.dtsi). The controller's own DMA
			 * caps register reads zero on this silicon (no SDMA
			 * / ADMA2); data path runs through the external DMA
			 * engine PIO-style via DREQ-paced FIFO accesses.
			 * Board overlay must also enable &dma. */
			dmas = <&dma 11>;
			dma-names = "rx-tx";
			status = "disabled";
		};

		/*
		 * Synopsys DesignWare USB 2.0 OTG controller. Single DWC2
		 * instance per SoC across the BCM2835/2836/2837/2710 family;
		 * wired straight to the micro-USB "USB" connector (the data-
		 * capable one, NOT the "PWR" port). OTG-capable but we drive
		 * it device-only for CDC-ACM serial -- runtime role switching
		 * to host mode is out of scope (no uhc_dwc2.c upstream and
		 * Pi Zero 2 W has only one controller, so any switch kills
		 * the CDC-ACM REPL anyway).
		 *
		 * Bus address 0x7e980000 → ARM-physical 0x3f980000.
		 *
		 * Interrupt: GPU IRQ 9 → bank-1 bit 9 on the ARMC aggregator
		 * → Zephyr IRQ 73 (BCM2835_BANK1(9)).
		 *
		 * GHWCFG1/2/4 values read from live silicon via the
		 * samples/boards/raspberrypi/rpi_zero_2w_dwc2_probe sample
		 * (Phase 2.0, 2026-05-18). GSNPSID 0x4f54280a = DWC2 OTG
		 * v2.80a. Key fields:
		 *   GHWCFG2 OtgArch=2 (Internal Buffer DMA supported)
		 *           HSPhyType=1 (UTMI+) FSPhyType=1 (Dedicated)
		 *           NumDevEp=7 NumHostChan=7 PerioEpSup=1 DynFifo=1
		 *   GHWCFG3 DfifoDepth=0x0ff0 (4080 32-bit words = 16 KiB)
		 *   GHWCFG4 UTMI_PHY_DATA_WIDTH=0 (8-bit) DedFifoEn=1
		 *           NumInEps=7 + EP0 = 8 total
		 *           OTG filters: Iddig/VbusValid/AValid/BValid/
		 *                        SessionEnd all enabled
		 *
		 * Probe also captured GINTSTS.CurMod=0: chip defaults to
		 * device mode out of VideoCore boot when nothing is plugged
		 * into the OTG port (ID floats). No host→device role flip
		 * needed at init.
		 *
		 * Compatible is vendor-string-first plus snps,dwc2 fallback
		 * (the modern idiomatic pattern -- ESP32, NRF, Synaptics
		 * all follow it). The vendor string triggers inclusion of
		 * `drivers/usb/udc/udc_dwc2_brcm_bcm2835_usb.h`, which
		 * declares HS-PHY capability via the `.caps` quirk hook --
		 * the generic driver reads GHWCFG2.HSPhyType but doesn't
		 * propagate it into `data->caps.hs`, so without this hook
		 * the device only advertises FS speeds.
		 *
		 * Default disabled -- board overlay opts in.
		 */
		usb: zephyr_udc0: usb@3f980000 {
			compatible = "brcm,bcm2835-usb", "snps,dwc2";
			reg = <0x3f980000 0x10000>;
			interrupts = <BCM2835_IRQ_USB IRQ_TYPE_LEVEL 0>;
			num-in-eps = <8>;
			num-out-eps = <8>;
			ghwcfg1 = <0x00000000>;
			ghwcfg2 = <0x228ddd50>;
			ghwcfg4 = <0x1ff00020>;
			status = "disabled";
		};
	};
};
