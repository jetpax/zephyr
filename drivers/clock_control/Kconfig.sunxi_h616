config CLOCK_CONTROL_SUN50I_H616_CCU
	bool "Allwinner sun50i H616/H618 CCU driver"
	default y
	depends on DT_HAS_ALLWINNER_SUN50I_H616_CCU_ENABLED
	help
	  Clock control driver for the Allwinner H616/H618 clock control
	  unit, covering the SD/MMC and display-path clocks.
