/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Enable V3D + firmware mailbox + console for the vec3_xform smoke
 * test on rpi_zero_2w. Mirrors qpu_smoke's overlay.
 */

&mbox0 {
	status = "okay";
};

&firmware {
	status = "okay";
};

&v3d {
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_gpio14>;
	status = "okay";
	current-speed = <115200>;
};

/ {
	chosen {
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
	};
};
