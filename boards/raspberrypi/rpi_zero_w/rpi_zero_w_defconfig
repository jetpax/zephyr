# RAM-loaded image -- no execute-in-place flash.
CONFIG_XIP=n

# Serial / console, interrupt-driven (shell needs UART RX interrupts).
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_INTERRUPT_DRIVEN=y

# Full managed MMU (arm_mmu.c) — auto-enabled via CPU_HAS_MMU + the
# VMSA_V7 short-descriptor path (ARM1176 uses it with XP instead of AFE).

# Kernel virtual address window. Zephyr's 8 MiB default is far too small
# for this board: on AArch32 the window has to hold the kernel image
# *and* every runtime mapping, while the board has 248 MiB of DRAM to
# draw on. Two ways it bites, both silent:
#
#   - a 1920x1080 ARGB8888 framebuffer is 8355840 bytes, so
#     device_map() fails with "insufficient virtual address space";
#   - an image larger than the window (a MicroPython build with an 8 MiB
#     heap reaches ~9 MiB) cannot map itself, and dies before the
#     console exists — no banner, no fault dump, just a dead board.
#
# Virtual space is free here: KERNEL_VM_BASE is 0x8000 and the
# peripherals do not start until 0x20000000.
CONFIG_KERNEL_VM_SIZE=0x2000000

# Classic ARM mode / exception stacks.
CONFIG_ARMV6_EXCEPTION_STACK_SIZE=4096
CONFIG_ARMV6_FIQ_STACK_SIZE=4096
CONFIG_ARMV6_SVC_STACK_SIZE=4096
CONFIG_ARMV6_SYS_STACK_SIZE=4096

# Kernel stacks.
CONFIG_ISR_STACK_SIZE=4096
CONFIG_MAIN_STACK_SIZE=4096
CONFIG_IDLE_STACK_SIZE=4096
