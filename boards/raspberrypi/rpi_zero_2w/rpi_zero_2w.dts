/dts-v1/;

#include <broadcom/bcm2710.dtsi>
#include <broadcom/bcm2711-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	model = "Raspberry Pi Zero 2 W";
	compatible = "raspberrypi,model-zero-2-w", "brcm,bcm2710";

	chosen {
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
		zephyr,sram = &sram0;
		zephyr,entropy = &rng;
		/* The OUTER zephyr,bt-hci-uart node (the H:4 driver), not the
		 * inner vendor node. Unused unless CONFIG_BT.
		 */
		zephyr,bt-hci = &bt_hci_uart;
	};

	aliases {
		die-temp0 = &vc_thermal;
	};

	aliases {
		sdhc0 = &sdhost;
	};

	aliases {
		sdhc0 = &emmc;
	};
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_gpio14>;
	current-speed = <115200>;
	status = "okay";
};

/* PL011 uart0 -> on-module CYW43436 Bluetooth HCI. A board-level fact
 * like the SDIO wireless below: GPIO 32/33 TXD0/RXD0 + GPIO 30/31
 * CTS0/RTS0 (ALT3, internal to the module -- not on the header), and
 * BT_REG_ON on GPIO 45 = bank1 pin 17 (sequenced by the AIROC driver).
 * Inert without CONFIG_BT: the H:4 + AIROC drivers are only compiled
 * with the BT stack; for everyone else uart0 just sits idle on the
 * internal pins. Baud stays 115200 -- fw-download-speed and
 * hci-operation-speed are deliberately omitted so the driver never
 * re-rates the UART. The PL011 drives real RTS/CTS (hw-flow-control).
 */
&uart0 {
	status = "okay";
	current-speed = <115200>;
	hw-flow-control;
	pinctrl-0 = <&uart0_ctsrts_gpio32>;
	pinctrl-names = "default";

	bt_hci_uart: bt_hci_uart {
		compatible = "zephyr,bt-hci-uart";
		status = "okay";

		bt_hci: bt-hci {
			compatible = "infineon,bt-hci-uart";
			bt-reg-on-gpios = <&gpio1 17 GPIO_ACTIVE_HIGH>;
		};
	};
};

/*
 * Enable SPI0 on the 40-pin header. No pinctrl-0 here: SPI pin
 * roles can be application-specific (e.g. a display sharing the
 * MISO pin for a D/C line), so muxing is left to an application
 * overlay.
 */
&spi0 {
	status = "okay";
};

/* Legacy SDHost controller -> external microSD card slot. The slot
 * is a board-level fact (PCB pad, GPIO 48..53 ALT0 routing is fixed),
 * so the enablement and sdmmc-disk child live in the board DTS.
 */
&sdhost {
	pinctrl-names = "default";
	pinctrl-0 = <&sdhost_gpio48>;
	status = "okay";

	sdmmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
	};
};

/*
 * BSC1 ("I2C1") on the 40-pin header -- GPIO 2 (SDA) and GPIO 3 (SCL).
 * The I2C pin roles on the header are fixed, so the pinctrl group is
 * wired here at the board level. clock-frequency defaults to 100 kHz;
 * an overlay can step it up to 400 kHz for fast-mode devices.
 */
&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_gpio2>;
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";
};

/* GPIO bank 1 (GPIO 28..45). Pin 41 carries WL_REG_ON for the
 * on-module wireless chip; enabling the bank makes the line
 * available to the brcmfmac driver.
 */
&gpio1 {
	status = "okay";
};

&dma {
	status = "okay";
};

/* Arasan SDHCI -> on-module CYW43xx SDIO wireless chip. The slot is
 * a board-level fact (PCB pad, GPIO 34..39 ALT3 + GPCLK2 on GPIO 43);
 * the routing lives in the board DTS.
 */
&emmc {
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_gpio34>;
	status = "okay";

	brcmfmac: brcmfmac {
		compatible = "brcm,bcm43xxx-sdio";
		wifi-reg-on-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};
