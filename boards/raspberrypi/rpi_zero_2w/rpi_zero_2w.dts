/dts-v1/;

#include <broadcom/bcm2710.dtsi>
#include <broadcom/bcm2711-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	model = "Raspberry Pi Zero 2 W";
	compatible = "raspberrypi,model-zero-2-w", "brcm,bcm2710";
	#address-cells = <1>;
	#size-cells = <1>;

	chosen {
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
		zephyr,sram = &sram0;
		zephyr,entropy = &rng;
	};

	/*
	 * Pi Zero 2 W has an on-board ACT LED, but it's wired through
	 * the firmware (not on a fixed GPIO accessible to the ARM cores)
	 * unlike the Pi 4 -- so no leds node here.
	 */
};

/*
 * NOTE: gpio0/gpio1 are deliberately left disabled. The Zephyr
 * "brcm,bcm2711-gpio" driver pokes the BCM2711-specific
 * GPIO_PUP_PDN_CNTRL_REG0 (offset 0xe4) on init, which doesn't
 * exist on the BCM2710 family -- QEMU raspi3b traps it as
 * "bcm2835_gpio_read: Bad offset e4" and on real hardware the
 * write is silently misrouted. machine.Pin() won't be available
 * until a BCM283x-aware GPIO driver lands or the bcm2711 driver
 * is taught the legacy pull-control sequence (GPPUD/GPPUDCLK
 * at 0x94/0x98/0x9c).
 */

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_gpio14>;
	current-speed = <115200>;
	status = "okay";
};

/*
 * The Arasan SDHCI controller is wired to the on-module CYW43439
 * wireless chip on this board. Driver is a skeleton today (methods
 * stub to -ENOTSUP); enabling lets the device probe so the boot log
 * confirms the DT path is right while the sequencer is filled in.
 */
&emmc {
	status = "okay";
};
