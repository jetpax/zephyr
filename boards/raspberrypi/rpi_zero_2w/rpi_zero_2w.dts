/dts-v1/;

#include <broadcom/bcm2710.dtsi>
#include <broadcom/bcm2711-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	model = "Raspberry Pi Zero 2 W";
	compatible = "raspberrypi,model-zero-2-w", "brcm,bcm2710";
	#address-cells = <1>;
	#size-cells = <1>;

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &sram0;
		zephyr,entropy = &rng;
	};

	/* sdhc0 alias: used by Zephyr's SDIO subsystem consumers
	 * (subsys/sd/sdio.c via tests/subsys/sd/sdio/) and by the
	 * BCM43430A1 bring-up shim in the MicroPython port.
	 *
	 * sdhc1 alias: the legacy SDHost controller driving the external
	 * microSD card slot; mounted at /sd from the MicroPython REPL via
	 * `vfs.mount(zephyr.DiskAccess("SD"), "/sd")`.
	 */
	aliases {
		sdhc0 = &emmc;
		sdhc1 = &sdhost;
	};

	/*
	 * Pi Zero 2 W has an on-board ACT LED, but it's wired through
	 * the firmware (not on a fixed GPIO accessible to the ARM cores)
	 * unlike the Pi 4 -- so no leds node here.
	 */
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_gpio14>;
	/*
	 * 1 Mbaud. With the default PL011 UART_CLK (48 MHz, from the
	 * SoC dtsi's clk_uart fixed-clock node) the divisor is exactly 3
	 * (IBRD=3, FBRD=0), giving 48 MHz / 16 / 3 = 1 MHz on the wire
	 * with zero error -- no clock-manager fractional precision to
	 * worry about. 921600 was tried first but the macOS USB-serial
	 * adapter used here produces ~850 kbps when asked for 921600;
	 * 1 Mbaud is unambiguous on both sides. Must match the
	 * init_uart_baud value in install-to-sdcard.sh's config.txt.
	 */
	current-speed = <1000000>;
	status = "okay";
};

/*
 * The Arasan SDHCI controller is wired to the on-module CYW43439
 * wireless chip on this board. The pinctrl groups route GPIO 34..39
 * to ALT3 (SD1_CLK / SD1_CMD / SD1_DAT0..3) and GPIO 43 to ALT0
 * (GPCLK2 -- the wireless-module reference clock). GPIO 41 ("WL_ON"
 * in the line-naming on Pi OS) is the chip's reset / regulator enable
 * (active high); the driver asserts it at init. Mirrors Linux's
 * bcm2837-rpi-zero-2-w.dts &sdhci + &wifi_pwrseq blocks.
 */
&emmc {
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_gpio34>;
	status = "okay";

	brcmfmac: brcmfmac {
		compatible = "brcm,bcm43xxx-sdio";
		wifi-reg-on-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
		firmware-name = "brcmfmac43436s-sdio";
		status = "okay";
	};
};

/*
 * Enable the BCM2835 DMA controller — the Arasan SDHCI driver above
 * uses it (DREQ 11) for its data phase, replacing what would otherwise
 * be a CPU-burning polled-PIO FIFO loop. Board-level rather than SoC-
 * level enablement because other boards may want a different mix of
 * DMA-using peripherals.
 */
&dma {
	status = "okay";
};

/*
 * SPI0 on the 40-pin header. Enabled as a SoC controller — the
 * controller is a chip fact, so it belongs in the board DTS (layered
 * board-config model). No pinctrl-0 here: pin muxing is a board /
 * runtime concern, supplied either by an overlay or a runtime
 * board-init shim. See /private/tmp/zephyr_board_config.html.
 */
&spi0 {
	status = "okay";
};

/*
 * BSC1 ("I2C1") on the 40-pin header — GPIO 2 (SDA) and GPIO 3 (SCL).
 * Unlike SPI, the I2C pin roles on the header are fixed (no D/C-style
 * dual-purpose role), so the pinctrl group is wired here at the board
 * level. clock-frequency defaults to 100 kHz; an overlay can step it
 * up to 400 kHz for fast-mode devices.
 */
&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_gpio2>;
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";
};

/*
 * Legacy SDHost controller -> external microSD card slot. The slot is
 * a board-level fact (it's on the Pi Zero 2 W PCB, GPIO 48..53 ALT0
 * routing is fixed), so the enablement + pinctrl + sdmmc-disk child
 * live in the board DTS rather than in an application overlay.
 *
 * The sdmmc child is a zephyr,sdmmc-disk node that the SD subsystem
 * (drivers/disk/sdmmc_subsys.c) consumes to register a disk_access
 * disk named "SD". From MicroPython that becomes /sd via
 * `vfs.mount(zephyr.DiskAccess("SD"), "/sd")`. The disk_access
 * registration only actually fires when CONFIG_DISK_DRIVER_SDMMC=y +
 * CONFIG_SDMMC_STACK=y in the application config; the DT node is
 * harmless when those are off.
 */
&sdhost {
	pinctrl-names = "default";
	pinctrl-0 = <&sdhost_gpio48>;
	status = "okay";

	sdmmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
	};
};
