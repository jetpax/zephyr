# Platform Configuration
CONFIG_ARM64_VA_BITS_36=y
CONFIG_ARM64_PA_BITS_36=y

# 64KB MMU page granule matches the Pi-downstream Linux kernel build
# for this SoC family.
CONFIG_ARM64_PAGE_SIZE_64KB=y

# MMU translation tables: 8 (the default) is right at the edge --
# image + L1_INTC + ARMCTRL_IC + sub-2MB region splits already fill
# most of them. Bump to 12 so SoC mmu_regions additions (e.g.
# MBOX_SCRATCH at 0x0F000000) can allocate the L3 tables they need
# without silent new_table() failure at MMU init.
CONFIG_MAX_XLAT_TABLES=12

# Zephyr Kernel Configuration
CONFIG_XIP=n
CONFIG_FLASH_SIZE=0
CONFIG_FLASH_BASE_ADDRESS=0x0

# Serial Drivers
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y

# Enable Console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Timer Drivers
CONFIG_TIMER_READS_ITS_FREQUENCY_AT_RUNTIME=y
